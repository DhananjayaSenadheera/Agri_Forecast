<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.2" />
    <PackageReference Include="FluentAssertions" Version="8.10.0" />
    <!-- SQLite EF provider — used only to pin the run-tracking context-isolation guarantee (B1):
         an audit write must run on its own ChangeTracker and never flush the ingestion context.
         SQLite (relational) is used rather than the InMemory provider because the production model
         seeds Market rows relying on a store default (IsEconomicCenter), which InMemory rejects. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="9.0.12" />
    <PackageReference Include="Microsoft.Extensions.Options" Version="10.0.9" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="Moq" Version="4.20.72" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <!-- The API reference (+ ASP.NET framework ref) lets us unit-test AuthController's
       cookie I/O and endpoint behaviour with a DefaultHttpContext, no TestServer needed. -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AgriForecast.Application\AgriForecast.Application.csproj" />
    <ProjectReference Include="..\AgriForecast.Domain\AgriForecast.Domain.csproj" />
    <ProjectReference Include="..\AgriForecast.Infrastructure\AgriForecast.Infrastructure.csproj" />
    <ProjectReference Include="..\AgriForecast.API\AgriForecast.API.csproj" />
    <!-- The Ingestion Worker is referenced so the SCHEDULED path can be tested directly. The worker must
         take the same cross-process application lock the admin start button takes, or the lock guards only
         one of its two callers; that invariant is only worth anything if it is asserted on the real
         Worker rather than on a stand-in. -->
    <ProjectReference Include="..\AgriForecast.Ingestion\AgriForecast.Ingestion.csproj" />
  </ItemGroup>

</Project>
